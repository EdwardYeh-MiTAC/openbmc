	/*B0-B7*/	"gpio-b0","","","","","","","",
	/*C0-C7*/	"chassis-power-good","FM_SKT1_FAULT_LED","","",
			"","","","",
	/*D0-D7*/	"gpio-d0","","","","","","","",
	/*E0-E7*/	"gpio-e0","","","","","","","",
	/*F0-F7*/	"gpio-f0","","","","","","","",
	/*G0-G7*/	"","","","","","","","",
	/*H0-H7*/	"gpio-h0","","","","","","","",
	/*I0-I7*/	"gpio-i0","","","","","","","",
	/*J0-J7*/	"gpio-j0","","","","","","","",
	/*K0-K7*/	"gpio-k0","","","","","","","",
	/*L0-L7*/	"gpio-l0","","","","","","","",
	/*M0-M7*/	"gpio-00","","","","","","","",
	/*N0-N7*/	"gpio-n0","nmi-control","","",
			"bios-post-complete","","","",
	/*O0-O7*/	"gpio-o0","","","","","","","",
	/*P0-P7*/	"","power-control","reset-button","reset-control",
			"nmi-button","","","",
	/*Q0-Q7*/	"gpio-q0","","","identify-led","","","","",
	/*R0-R7*/	"gpio-r0","","","","bmc-ready-n","","","",
	/*S0-S7*/	"gpio-s0","","","",
			"","cmos-bat-scaled-en-n","","",
	/*T0-T7*/	"gpio-t0","","","","","","","",
	/*U0-U7*/	"gpio-u0","","","","","","power-button","",
	/*V0-V7*/	"SIO_S3","SIO_S5","","SIO_ONCONTROL",
			"","spi-mux-bios","","",
	/*W0-W7*/	"gpio-w0","","","","","","","",
	/*X0-X7*/	"gpio-x0","","","","","","","",
	/*Y0-Y7*/	"gpio-y0","","","","","","","",
	/*Z0-Z7*/	"gpio-z0","identify-button","FM_FAN_PCA9555_INT_R_N","","","","","";
};

&gpio1 {
	gpio-line-names =
	/*18A0-18A7*/	"","","","",
			"","","","",
	/*18B0-18B7*/	"","","","","","","","",
	/*18C0-18C7*/	"","","","",
			"","","","",
	/*18D0-18D7*/	"","","","","","","","",
	/*18E0-18E3*/	"","","","";
};

#include "aspeed-bmc-mitac-common.dtsi"
#include "aspeed-bmc-mitac-2600-enable-dp.dtsi"
