/dts-v1/;

#include "aspeed-g6.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>

/ {
	model = "MiTAC R520G6 20250516";
	#include "aspeed-bmc-mitac-2600-reserved-memory.dtsi"

        leds {
                compatible = "gpio-leds";

                bmc_heartbeat {
                        gpios = <&gpio0 ASPEED_GPIO(P, 7) GPIO_ACTIVE_LOW>;
                        default-state = "on";
                };
                identify {
                        gpios = <&gpio0 ASPEED_GPIO(Q, 3) GPIO_ACTIVE_LOW>;
                        default-state = "off";
                };
                fault {
                        gpios = <&gpio0 ASPEED_GPIO(G, 3) GPIO_ACTIVE_LOW>;
                        default-state = "off";
                };

                cpu0_fault {
                        gpios = <&gpio0 ASPEED_GPIO(C, 0) GPIO_ACTIVE_HIGH>;
                        default-state = "off";
                };
                cpu1_fault {
                        gpios = <&gpio0 ASPEED_GPIO(C, 1) GPIO_ACTIVE_HIGH>;
                        default-state = "off";
                };

                fan1_fault {
                        gpios = <&pca9555_11_20 8 GPIO_ACTIVE_HIGH>;
                        default-state = "off";
                };
                fan2_fault {
                        gpios = <&pca9555_11_20 9 GPIO_ACTIVE_HIGH>;
                        default-state = "off";
                };
                fan3_fault {
                        gpios = <&pca9555_11_20 10 GPIO_ACTIVE_HIGH>;
                        default-state = "off";
                };
                fan4_fault {
                        gpios = <&pca9555_11_20 11 GPIO_ACTIVE_HIGH>;
                        default-state = "off";
                };
                fan5_fault {
                        gpios = <&pca9555_11_20 12 GPIO_ACTIVE_HIGH>;
                        default-state = "off";
                };
                fan6_fault {
                        gpios = <&pca9555_11_20 13 GPIO_ACTIVE_HIGH>;
                        default-state = "off";
                };

		#include "aspeed-bmc-mitac-common-intel-bhs-sgpio-leds.dtsi"
        };

        gpio-keys {
                compatible = "gpio-keys";

		#include "aspeed-bmc-mitac-common-buttons.dtsi"
        };

        iio-hwmon {
                compatible = "iio-hwmon";
                io-channels = <&adc0 0>, <&adc0 1>, <&adc0 2>, <&adc0 3>,
                        <&adc0 4>, <&adc0 5>, <&adc0 6>, <&adc0 7>,
                        <&adc1 0>, <&adc1 1>, <&adc1 2>, <&adc1 3>,
                        <&adc1 4>, <&adc1 5>, <&adc1 6>, <&adc1 7>;
        };
};

&mdio0 {
	status = "okay";

	ethphy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&mac0 {
        status = "okay";

        phy-mode = "rgmii-rxid";
        phy-handle = <&ethphy0>;

        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_rgmii1_default>;
};

&mac3 {
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_rmii4_default>;
        clock-names = "MACCLK", "RCLK";
        use-ncsi;
};

&rtc {
	status = "okay";
};

&fmc {
	status = "okay";
	flash@0 {
		status = "okay";
		m25p,fast-read;
		label = "bmc";
		spi-rx-bus-width = <4>;
		spi-max-frequency = <50000000>;
#include "MiOBMC-flash-layout-64.dtsi"
	};
};

&spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi1_default>;

	flash@0 {
		status = "okay";
		m25p,fast-read;
		label = "pnor";
		spi-rx-bus-width = <1>;
		spi-max-frequency = <50000000>;
	};
};

&uart3 {
        status = "okay";
};

&uart4 {
        status = "okay";
};

&uart5 {
	// Workaround for A0
	compatible = "snps,dw-apb-uart";
};

&uart_routing {
        status = "okay";
};

&lpc_snoop {
	status = "okay";
	snoop-ports = <0x80>, <0x81>;
};

&lpc_ctrl {
	status = "okay";
};

