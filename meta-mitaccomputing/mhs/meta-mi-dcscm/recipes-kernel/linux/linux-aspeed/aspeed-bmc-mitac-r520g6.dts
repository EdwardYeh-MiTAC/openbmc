        status = "okay";
        perif-dma-mode;
        oob-dma-mode;
        flash-dma-mode;
};
*/

/*
&i2c1 {
	status = "okay";
};
&i2c2 {
        status = "okay";
};
*/

&i2c3 {
        status = "okay";
};
&i2c4 {
        status = "okay";
	// MB FRU for MPH
	eeprom@50 {
		compatible = "atmel,24c256";
		reg = <0x50>;
	};
	// DC-SCM FRU on E7142 DCSCM
	eeprom@51 {
		compatible = "atmel,24c64";
		reg = <0x51>;
	};
};
&i2c5 {
        status = "okay";
};
&i2c6 {
        status = "okay";
};
&i2c7 {
        status = "okay";
};
&i2c8 {
        status = "okay";
};
&i2c9 {
        status = "okay";
};
&i2c10 {
        status = "okay";
};
&i2c11 {
        status = "okay";
	/* Plan to move to device configurration for Entity Manager. */
	pca9555_11_20: pca9555@20 {
		compatible = "nxp,pca9555";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-parent = <&gpio0>;
		interrupts = <ASPEED_GPIO(Z, 2) IRQ_TYPE_LEVEL_LOW>;
		gpio-line-names =
			"FAN1_PRSNT_N", "FAN2_PRSNT_N", "FAN3_PRSNT_N", "FAN4_PRSNT_N",
			"FAN5_PRSNT_N", "FAN6_PRSNT_N", "FAN7_PRSNT_N", "FAN8_PRSNT_N",
			"FAN_LED1", "FAN_LED2", "FAN_LED3", "FAN_LED4",
			"FAN_LED5", "FAN_LED6", "FAN_LED7", "FAN_LED8";
        };

	/* NCT7363 Driver Issue
	*  Intentionally attempt to initialize NCT7363 in device tree so that this FCB could be supported as second source.
        *  This arrangement is due to the NCT7363 driver doesn't have complete support for operations on Sysfs.
	*/ 
        nct7363_11_21: nct7363@21 {
            compatible = "nuvoton,nct7363";
            reg = <0x21>;
            #pwm-cells = <2>;

            fan-0 {
                pwms = <&nct7363_11_21 0 50000>;
                tach-ch = /bits/ 8 <9>;
            };
            fan-1 {
                pwms = <&nct7363_11_21 0 50000>;
                tach-ch = /bits/ 8 <10>;
            };
            fan-2 {
                pwms = <&nct7363_11_21 4 50000>;
                tach-ch = /bits/ 8 <13>;
            };
            fan-3 {
                pwms = <&nct7363_11_21 4 50000>;
                tach-ch = /bits/ 8 <14>;
            };
            fan-4 {
                pwms = <&nct7363_11_21 8 50000>;
                tach-ch = /bits/ 8 <1>;
            };
            fan-5 {
                pwms = <&nct7363_11_21 8 50000>;
                tach-ch = /bits/ 8 <2>;
            };
        };	

        nct7363_11_22: nct7363@22 {
            compatible = "nuvoton,nct7363";
            reg = <0x22>;
            #pwm-cells = <2>;

            fan-6 {
                pwms = <&nct7363_11_22 0 50000>;
                tach-ch = /bits/ 8 <9>;
            };
            fan-7 {
                pwms = <&nct7363_11_22 0 50000>;
                tach-ch = /bits/ 8 <10>;
            };
            fan-8 {
                pwms = <&nct7363_11_22 4 50000>;
                tach-ch = /bits/ 8 <13>;
            };
            fan-9 {
                pwms = <&nct7363_11_22 4 50000>;
                tach-ch = /bits/ 8 <14>;
            };
            fan-10 {
                pwms = <&nct7363_11_22 8 50000>;
                tach-ch = /bits/ 8 <1>;
            };
            fan-11 {
                pwms = <&nct7363_11_22 8 50000>;
                tach-ch = /bits/ 8 <2>;
            };
        };
};
