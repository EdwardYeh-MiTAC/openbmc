From e14cada8326a53fe10e3e64697d896658e586775 Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Tue, 29 Jul 2025 08:37:32 +0000
Subject: [PATCH 1/1] Fixed the build issue after upgraded to C++23 and Boost
 ver 1.86.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 CMakeLists.txt                    | 11 ++++++-----
 include/hw/aspeed/PCIeMonitor.hpp |  2 +-
 src/PCIeBinding.cpp               |  6 ++++--
 src/SMBusBinding.cpp              |  9 ++++++---
 src/utils/transmission_queue.cpp  |  8 ++++----
 5 files changed, 21 insertions(+), 15 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index cccba4b..e606712 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -6,7 +6,7 @@ project(mctpd CXX)
 option(BUILD_STANDALONE "Use outside of YOCTO depedencies system" OFF)
 
 set(BUILD_SHARED_LIBRARIES OFF)
-set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD 23)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
 add_definitions(-DMCTP_ASTPCIE_RESPONSE_WA)
@@ -20,13 +20,13 @@ set(CMAKE_CXX_FLAGS
     -Wnon-virtual-dtor \
     -Wold-style-cast \
     -Wcast-align \
-    -Wunused \
     -Woverloaded-virtual \
     -Wpedantic \
     -Wconversion \
-    -Wnull-dereference \
     -Wdouble-promotion \
     -Wformat=2 \
+    -Wno-psabi \
+    -Werror=unused-result \
 ")
 
 if("${CMAKE_CXX_COMPILER_ID}" STREQUAL "GNU")
@@ -105,7 +105,7 @@ if(BUILD_STANDALONE)
   include_directories(SYSTEM ${CMAKE_BINARY_DIR}/libs/nlohmann-json/include)
 endif()
 
-find_package(Boost 1.71 REQUIRED)
+find_package(Boost 1.87 REQUIRED)
 include_directories(SYSTEM ${BOOST_SRC_DIR})
 
 add_executable(${PROJECT_NAME} ${SRC_FILES} ${HEADER_FILES})
@@ -118,7 +118,8 @@ target_link_libraries(
   mctp_intel
   udev
   i2c
-  boost_coroutine)
+  boost_coroutine
+  boost_context)
 
 install(TARGETS ${PROJECT_NAME} DESTINATION bin)
 install(FILES ${SERVICE_FILES} DESTINATION /lib/systemd/system/)
