+    },
+    boost::asio::detached);
 }
 
 mctp_server::BindingModeTypes
@@ -360,7 +361,8 @@ void PCIeBinding::updateRoutingTable()
             processRoutingTableChanges(routingTableTmp, yield, prvData);
             routingTable = routingTableTmp;
