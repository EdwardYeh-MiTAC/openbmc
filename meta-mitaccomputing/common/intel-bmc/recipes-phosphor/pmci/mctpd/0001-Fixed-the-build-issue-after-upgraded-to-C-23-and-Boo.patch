index cc96540..3388f84 100644
--- a/src/PCIeBinding.cpp
+++ b/src/PCIeBinding.cpp
@@ -73,7 +73,8 @@ void PCIeBinding::endpointDiscoveryFlow()
             phosphor::logging::log<phosphor::logging::level::ERR>(
                 "Discovery Notify failed");
         }
