#!/bin/bash -e

GetPwrState() {
    PwrState=`busctl get-property xyz.openbmc_project.State.Host /xyz/openbmc_project/state/host0 xyz.openbmc_project.State.Host CurrentHostState | cut -d " " -f 2`
    #echo $PwrState

    if [[ $PwrState == *"Running"* ]]; then
        CurrPwrState="on"
    else
        CurrPwrState="off"
    fi
    # echo "CurrPwrState Host Power State: $CurrPwrState"
    # echo "LastPwrState Host Power State: $LastPwrState"
}

source /tmp/mainboard_env.sh

# Wait for D-Bus services to stabilize after BMC reboot to avoid false 'off' state
sleep 3

# Perform an initial state check to sync the current host status
GetPwrState

# Initialize LastPwrState to prevent unexpected transition triggers in the first loop
LastPwrState=$CurrPwrState

# Execute the corresponding action immediately based on the current state at startup
if [[ $CurrPwrState == "on" ]]; then
    echo "Initial state is ON. Syncing power-on actions..."
    action_power_transition_on
else
    echo "Initial state is OFF. Syncing power-off actions..."
    action_power_transition_off
fi

while [ true ]
do
    GetPwrState
    if [[ $CurrPwrState != $LastPwrState ]]; then
        if [[ $LastPwrState == "off" ]]; then
                echo "Call action for transition to ON"
		set +e
                action_power_transition_on
		set -e
        fi

        if [[ $LastPwrState == "on" ]]; then
                echo "Call action for transition to OFF"
		set +e
                action_power_transition_off
		set -e
	else
		if [[ $CurrPwrState == "off" ]]; then
			echo "Regular task while powered off"
			set +e
			action_power_status_off
			set -e
		else
			echo "Regular task while powered on"
			set +e
			action_power_status_on
			set -e
		fi
        fi
    fi
    LastPwrState=$CurrPwrState
    sleep 5
done
