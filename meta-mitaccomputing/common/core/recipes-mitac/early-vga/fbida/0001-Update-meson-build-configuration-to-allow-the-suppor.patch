From b7b06d2dea2168ae27b0e8dc959c510ff7834be5 Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Wed, 14 May 2025 03:25:57 +0000
Subject: [PATCH 1/3] Update meson build configuration to allow the support of
 early_vga.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 meson.build       | 17 +++++++++++++++++
 meson_options.txt |  2 +-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 289d1ec..cfd1d0d 100644
--- a/meson.build
+++ b/meson.build
@@ -28,6 +28,7 @@ udev_dep     = dependency('libudev')
 input_dep    = dependency('libinput')
 xkb_dep      = dependency('xkbcommon', required : false)
 tsm_dep      = dependency('libtsm', required : false)
+earlyvga_dep = dependency('dbus-1')
 
 # other library deps
 cc           = meson.get_compiler('c')
@@ -107,6 +108,22 @@ executable('fbi',
            install             : true)
 install_man('man/fbi.1')
 
+# build early_vga
+early_vga_srcs     = [ 'early_vga.c', 'fb-gui.c', 'desktop.c',
+                 'parseconfig.c', 'fbiconfig.c',
+                 'vt.c', 'kbd.c', 'fbtools.c', 'drmtools.c', 'gfx.c',
+                 'filter.c', 'op.c', 'jpegtools.c',
+                 trans_src, read_srcs ]
+early_vga_deps     = [ drm_dep, pixman_dep, cairo_dep,
+                 exif_dep, image_deps,
+                 math_dep, udev_dep, input_dep, earlyvga_dep ]
+
+executable('early_vga',
+           sources             : early_vga_srcs,
+           dependencies        : early_vga_deps,
+           include_directories : trans_inc,
+           install             : true)
+
 # build exiftran
 exiftr_srcs  = [ 'exiftran.c', 'genthumbnail.c', 'jpegtools.c',
                  'filter.c', 'op.c', 'readers.c', 'rd/read-jpeg.c',
diff --git a/meson_options.txt b/meson_options.txt
index 74699ab..1413887 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -3,4 +3,4 @@ option('png', type: 'feature', value : 'enabled')
 option('tiff', type: 'feature', value : 'enabled')
 option('webp', type: 'feature', value : 'disabled')
 option('motif', type: 'feature', value : 'disabled')
-option('pdf', type: 'feature', value : 'enabled')
+option('pdf', type: 'feature', value : 'disabled')
-- 
