From 313b639395ae20c47197ebb696d374d8e15e3c30 Mon Sep 17 00:00:00 2001
From: "fredy.chen" <fredy.chen@mitaccomputing.com>
Date: Mon, 25 May 2026 01:50:33 -0400
Subject: [PATCH] Support IPMI add sel entry command

Upstream-Status: Inappropriate [No upstream maintenance]
---
 src/storagecommands.cpp | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/src/storagecommands.cpp b/src/storagecommands.cpp
index e38d8ac..3f74cd0 100644
--- a/src/storagecommands.cpp
+++ b/src/storagecommands.cpp
@@ -1066,6 +1066,35 @@ ipmi::RspType<uint16_t,                   // Next Record ID
     return ipmi::responseUnspecifiedError();
 }
 
+bool addSELEntry(uint16_t generatorID, uint8_t sensorNum, uint8_t eventType,
+                 uint8_t eventData1, uint8_t eventData2, uint8_t eventData3)
+{
+    // Use IPMI Logging DBus method to log the event
+    std::shared_ptr<sdbusplus::asio::connection> dbus = getSdBus();
+
+    std::string message = "SEL Entry Added";
+    // Reverse-map sensor number to D-Bus object path (same bimap used by
+    // GetSELEntry for the forward direction)
+    std::string sensorPath = getPathFromSensorNumber(sensorNum);
+    std::vector<uint8_t> eventData = {eventData1, eventData2, eventData3};
+    bool assert = !(eventType & 0x80);  // bit 7: 0=assertion, 1=deassertion
+
+    sdbusplus::message_t selMessage = dbus->new_method_call(
+        "xyz.openbmc_project.Logging.IPMI", "/xyz/openbmc_project/Logging/IPMI", "xyz.openbmc_project.Logging.IPMI",
+        "IpmiSelAdd");
+    selMessage.append(message, sensorPath, eventData, assert, generatorID);
+    try    {
+        sdbusplus::message_t logResponse = dbus->call(selMessage);
+    }
+    catch (const sdbusplus::exception_t& e)
+    {
+        phosphor::logging::log<phosphor::logging::level::ERR>(e.what());
+        return false;
+    }
+
+    return true;
+}
+
 ipmi::RspType<uint16_t> ipmiStorageAddSELEntry(
     uint16_t recordID, uint8_t recordType, uint32_t timestamp,
     uint16_t generatorID, uint8_t evmRev, uint8_t sensorType, uint8_t sensorNum,
@@ -1082,6 +1111,12 @@ ipmi::RspType<uint16_t> ipmiStorageAddSELEntry(
         recordID, recordType, timestamp, generatorID, evmRev, sensorType,
         sensorNum, eventType, eventData1, eventData2, eventData3);
 
+    if(!addSELEntry(generatorID, sensorNum, eventType, eventData1, eventData2, eventData3))
+    {
+        phosphor::logging::log<phosphor::logging::level::ERR>("Failed to add SEL entry");
+        return ipmi::responseUnspecifiedError();
+    }
+
     uint16_t responseID = 0xFFFF;
     return ipmi::responseSuccess(responseID);
 }
