From 7ca8bdf88c693c063ea133348019bddb9754b623 Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Tue, 3 Jun 2025 08:14:22 +0000
Subject: [PATCH 1/1] Enabled CONFIG_BOARD_EARLY_INIT_F to support early IO
 configuration.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 configs/mitac-beoc_defconfig     | 1 +
 configs/mitac-capri_defconfig    | 1 +
 configs/mitac-mi-dcscm_defconfig | 1 +
 3 files changed, 3 insertions(+)

diff --git a/configs/mitac-beoc_defconfig b/configs/mitac-beoc_defconfig
index 7b06cd695c..1efff5f1e8 100644
--- a/configs/mitac-beoc_defconfig
+++ b/configs/mitac-beoc_defconfig
@@ -170,3 +170,4 @@ CONFIG_SPL_CRC32=y
 CONFIG_HEXDUMP=y
 # CONFIG_EFI_LOADER is not set
 CONFIG_PHANDLE_CHECK_SEQ=y
+CONFIG_BOARD_EARLY_INIT_F=y
diff --git a/configs/mitac-capri_defconfig b/configs/mitac-capri_defconfig
index 7b06cd695c..1efff5f1e8 100644
--- a/configs/mitac-capri_defconfig
+++ b/configs/mitac-capri_defconfig
@@ -170,3 +170,4 @@ CONFIG_SPL_CRC32=y
 CONFIG_HEXDUMP=y
 # CONFIG_EFI_LOADER is not set
 CONFIG_PHANDLE_CHECK_SEQ=y
+CONFIG_BOARD_EARLY_INIT_F=y
diff --git a/configs/mitac-mi-dcscm_defconfig b/configs/mitac-mi-dcscm_defconfig
index 7b06cd695c..1efff5f1e8 100644
--- a/configs/mitac-mi-dcscm_defconfig
+++ b/configs/mitac-mi-dcscm_defconfig
@@ -170,3 +170,4 @@ CONFIG_SPL_CRC32=y
 CONFIG_HEXDUMP=y
 # CONFIG_EFI_LOADER is not set
 CONFIG_PHANDLE_CHECK_SEQ=y
+CONFIG_BOARD_EARLY_INIT_F=y
