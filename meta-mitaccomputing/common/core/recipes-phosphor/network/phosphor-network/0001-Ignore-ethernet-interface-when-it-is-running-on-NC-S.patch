diff --git a/src/network_manager.cpp b/src/network_manager.cpp
index 75c759b..696bcf3 100644
--- a/src/network_manager.cpp
+++ b/src/network_manager.cpp
@@ -231,6 +231,18 @@ void Manager::addInterface(const InterfaceInfo& info)
             ignoredIntf.emplace(info.idx);
             return;
         }
+        if (isNCSIEthIntf(*info.name))
+        {
+            const unsigned packageId =
+                phosphor::network::internal::getPackageIdFromEnv(*info.name);
+            if (!hasValidChannel(info.idx, packageId))
+            {
+                lg2::info(
+                    "Ignoring interface {NET_INTF} due to unable to find valid NC-SI NIC at package id {PKG_ID}.",
+                    "NET_INTF", *info.name, "PKG_ID", packageId);
+                ignoredIntf.emplace(info.idx);
+            }
+        }
     }
 
     auto infoIt = intfInfo.find(info.idx);
diff --git a/src/util.cpp b/src/util.cpp
