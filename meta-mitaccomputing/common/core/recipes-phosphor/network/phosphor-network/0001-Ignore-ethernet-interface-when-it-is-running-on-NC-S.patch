--- a/src/util.cpp
+++ b/src/util.cpp
@@ -3,6 +3,7 @@
 #include "util.hpp"
 
 #include "config_parser.hpp"
+#include "ncsi_util.hpp"
 #include "types.hpp"
 
 #include <sys/wait.h>
@@ -15,6 +16,7 @@
 #include <xyz/openbmc_project/Common/error.hpp>
 
 #include <cctype>
+#include <filesystem>
 #include <fstream>
 #include <string>
 #include <string_view>
@@ -87,6 +89,37 @@ std::string_view getIgnoredInterfacesEnv()
     return r;
 }
 
+unsigned getPackageIdFromEnv(const std::string intfName)
+{
+    const std::string evnVarName = intfName + "_PkgId";
+    auto r = std::getenv(evnVarName.c_str());
+    unsigned pkgId = 0;
+    if (r == nullptr)
+    {
+        return pkgId;
+    }
+    try
+    {
+        pkgId = std::stoul(r);
+    }
+    catch (const std::invalid_argument& e)
+    {
+        lg2::error("Invalid argument for {ENV}: {EXCEPTION}", "ENV", evnVarName,
+                   "EXCEPTION", e.what());
+    }
+    catch (const std::out_of_range& e)
+    {
+        lg2::error("Out of range while process {ENV}: {EXCEPTION}", "ENV",
+                   evnVarName, "EXCEPTION", e.what());
+    }
+    catch (...)
+    {
+        lg2::error("An unknown error occurred while process {ENV}", "ENV",
+                   evnVarName);
+    }
+    return pkgId;
+}
+
 /** @brief Parse the comma separated interface names */
 std::unordered_set<std::string_view> parseInterfaces(
     std::string_view interfaces)
@@ -126,6 +159,38 @@ const std::unordered_set<std::string_view>& getIgnoredInterfaces()
 
 } // namespace internal
 
+bool hasValidChannel(const unsigned intfId, const unsigned pkgId)
+{
+    phosphor::network::ncsi::NetlinkInterface interface(intfId);
+    auto info = interface.getInfo(pkgId);
+    if (info)
+    {
+        phosphor::network::ncsi::InterfaceInfo& iInfo = *info;
+        for (phosphor::network::ncsi::PackageInfo& pkg : iInfo.packages)
+        {
+            lg2::debug("Network Intf {INTFID} Package {ID} is valid NC-SI NIC.",
+                       "INTFID", intfId, "ID", pkg.id);
+            return true;
+        }
+    }
+    return false;
+}
+
+bool isNCSIEthIntf(const std::string intfName)
+{
+    const std::string filename =
+        "/sys/class/net/" + intfName + "/device/of_node/use-ncsi";
+
+    if (std::filesystem::exists(filename))
+    {
+        return true;
+    }
+    else
+    {
+        return false;
+    }
+}
+
 std::optional<std::string> interfaceToUbootEthAddr(std::string_view intf)
 {
     constexpr auto pfx = "eth"sv;
