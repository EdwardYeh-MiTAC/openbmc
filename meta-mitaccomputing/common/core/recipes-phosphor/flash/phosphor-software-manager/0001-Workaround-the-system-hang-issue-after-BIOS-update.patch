From 7e49afa218e1c60c4dcc0e0e5320f55dff12418a Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Tue, 8 Jul 2025 03:31:08 +0000
Subject: [PATCH 1/1] Workaround the system hang issue after BIOS update.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 bios/spi_device.cpp               | 10 +++++++---
 common/pldm/pldm_package_util.cpp |  5 +++--
 2 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/bios/spi_device.cpp b/bios/spi_device.cpp
index 7372c40..9f0bc1b 100644
--- a/bios/spi_device.cpp
+++ b/bios/spi_device.cpp
@@ -235,8 +235,6 @@ static std::unique_ptr<::gpiod::line_bulk> requestMuxGPIOs(
     ::gpiod::line_request config{"", ::gpiod::line_request::DIRECTION_OUTPUT,
                                  0};
 
-    debug("[gpio] requesting gpios to mux SPI to BMC");
-
     auto lineBulk = std::make_unique<::gpiod::line_bulk>(lines);
 
     if (inverted)
@@ -285,6 +283,7 @@ sdbusplus::async::task<bool> SPIDevice::writeSPIFlash(const uint8_t* image,
         {
             if (tool == flashToolFlashrom)
             {
+                info("writeSPIFlash: flashToolFlashrom");
                 const int status =
                     co_await SPIDevice::writeSPIFlashWithFlashrom(image,
                                                                   image_size);
@@ -299,12 +298,16 @@ sdbusplus::async::task<bool> SPIDevice::writeSPIFlash(const uint8_t* image,
             }
             else
             {
+                info("writeSPIFlash: default");
                 success =
                     co_await SPIDevice::writeSPIFlashDefault(image, image_size);
             }
         }
 
-        success = success && co_await SPIDevice::unbindSPIFlash();
+        /* TODO: Uncertain issue could cause system hang after unbind spi.
+        *  The workaround is to unbind spi after switch MUX.
+        */
+        //success = success && co_await SPIDevice::unbindSPIFlash();
     }
 
     lineBulk->release();
@@ -321,6 +324,7 @@ sdbusplus::async::task<bool> SPIDevice::writeSPIFlash(const uint8_t* image,
     }
 
     lineBulk->release();
+    success = success && co_await SPIDevice::unbindSPIFlash();
 
     co_return success;
 }
diff --git a/common/pldm/pldm_package_util.cpp b/common/pldm/pldm_package_util.cpp
index 2d348a0..25c53b2 100644
--- a/common/pldm/pldm_package_util.cpp
+++ b/common/pldm/pldm_package_util.cpp
@@ -18,6 +18,7 @@
 #include <cassert>
 #include <cstring>
 #include <functional>
+#include <iostream>
 
 PHOSPHOR_LOG2_USING;
 
@@ -149,7 +150,7 @@ bool fwDeviceIDRecordMatchesCompatible(const FirmwareDeviceIDRecord& record,
     auto data = std::get<VendorDefinedDescriptorInfo>(v);
 
     std::string actualCompatible = std::get<VendorDefinedDescriptorTitle>(data);
-
+    info("Compatible: {COMPATIBLE}, FW Image: {ACTUAL}", "COMPATIBLE", compatible, "ACTUAL", actualCompatible);
     return compatible == actualCompatible;
 }
 
@@ -186,7 +187,7 @@ bool fwDeviceIDRecordMatchesIANA(const FirmwareDeviceIDRecord& record,
     }
 
     const uint32_t actualIANA = dd[0] | dd[1] << 8 | dd[2] << 16 | dd[3] << 24;
-
+    info("IANA: {IANA}, FW Image: {ACTUAL}", "IANA", std::to_string(vendorIANA), "ACTUAL", std::to_string(actualIANA));
     return actualIANA == vendorIANA;
 }
 
