Subject: [PATCH 1/1] Temporarily use Other to identify the host image in PLDM
 FW format. Will extend the VersionPurpose later.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 bios/bios_software_manager.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bios/bios_software_manager.cpp b/bios/bios_software_manager.cpp
index d7623e4..8b72329 100644
--- a/bios/bios_software_manager.cpp
+++ b/bios/bios_software_manager.cpp
@@ -103,7 +103,7 @@ sdbusplus::async::task<bool> BIOSSoftwareManager::initDevice(
 
     spiDevice->softwareCurrent = std::move(software);
 
-    spiDevice->softwareCurrent->setVersion(SPIDevice::getVersion());
+    spiDevice->softwareCurrent->setVersion(SPIDevice::getVersion(), SoftwareVersion::VersionPurpose::Other);
 
     devices.insert({config.objectPath, std::move(spiDevice)});
 
