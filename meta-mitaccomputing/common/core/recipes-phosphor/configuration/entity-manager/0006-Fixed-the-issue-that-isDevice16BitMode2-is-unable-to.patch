From 2ee4ec37260ef21a3d0511243650e30adc42fc49 Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Fri, 26 Dec 2025 09:20:36 +0000
Subject: [PATCH 1/1] Fixed the issue that isDevice16BitMode2 is unable to
 identify NVMe FRU device.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 src/fru_device/fru_device.cpp | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/fru_device/fru_device.cpp b/src/fru_device/fru_device.cpp
index f4e3251..d7dcc24 100644
--- a/src/fru_device/fru_device.cpp
+++ b/src/fru_device/fru_device.cpp
@@ -332,6 +332,26 @@ static int64_t readData(bool is16bit, bool isBytewise, int file,
     return i2cSmbusWriteThenRead(file, address, u8Offset, 2, buf, len);
 }
 
+static int is8BitAddrDev(int file, uint16_t address)
+{
+    int ret = i2c_smbus_write_byte(file, 0);
+    if (ret < 0)
+    {
+        return -1;
+    }
+
+    uint16_t v = 0;
+    uint8_t* p = reinterpret_cast<uint8_t*>(&v);
+    uint8_t u8RespData;
+    // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
+    ret = i2cSmbusWriteThenRead(file, address, p, 2, &u8RespData, 1);
+    if (ret < 0)
+    {
+        return 1;
+    }
+    return 0;
+}
+
 // Mode_1:
 // --------
 // Please refer to document docs/address_size_detection_modes.md for
@@ -413,6 +433,11 @@ static std::optional<bool> isDevice16BitMode2(int file, uint16_t address)
 
 static std::optional<bool> isDevice16Bit(int file, uint16_t address)
 {
+    if (is8BitAddrDev(file, address) == 1)
+    {
+        return false;
+    }
+
     std::string mode(fruDevice16BitDetectMode);
 
     if (mode == "MODE_2")
-- 
