From d788c2a89abd7e17103f43b3a9f923916943f5fa Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Mon, 22 Dec 2025 00:29:59 +0000
Subject: [PATCH 1/1] Changed the default 16Bits detect mode from MODE_1 to
 MODE_2 to fix addressing issue on AT24C256.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 meson.options | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/meson.options b/meson.options
index 65c1f97..02425d0 100644
--- a/meson.options
+++ b/meson.options
@@ -14,7 +14,7 @@ option(
     'fru-device-16bitdetectmode',
     type: 'combo',
     choices: ['MODE_1', 'MODE_2'],
-    value: 'MODE_1',
+    value: 'MODE_2',
     description: 'Different modes to detect 16-bit address EEPROM devices. MODE_1 is current and default mode.',
 )
 option(
-- 
2.45.2

