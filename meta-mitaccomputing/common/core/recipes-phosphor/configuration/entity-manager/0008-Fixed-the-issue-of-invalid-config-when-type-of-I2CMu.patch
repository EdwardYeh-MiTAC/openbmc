From d364d473e86eb4dfae37ee69fec70b322f0969c1 Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Tue, 27 Jan 2026 02:50:14 +0000
Subject: [PATCH 1/1] Fixed the issue of invalid config when type of I2CMux
 reference to the MuxChannel from another configuration file.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 src/entity_manager/overlay.cpp | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/src/entity_manager/overlay.cpp b/src/entity_manager/overlay.cpp
index b7145c3..3e0d662 100644
--- a/src/entity_manager/overlay.cpp
+++ b/src/entity_manager/overlay.cpp
@@ -37,6 +37,8 @@
 #include <regex>
 #include <string>
 
+namespace fs = std::filesystem;
+
 constexpr const char* outputDir = "/tmp/overlays";
 constexpr const char* templateChar = "$";
 constexpr const char* i2CDevsDir = "/sys/bus/i2c/devices";
@@ -343,7 +345,29 @@ bool exportDevice(const std::string& type,
             }
             else
             {
-                return false;
+                // Try to resolve the bus number from MuxChannel
+                std::filesystem::path muxFilePath(muxSymlinkDir);
+                muxFilePath = muxFilePath / muxChannel["MuxName"] / muxChannel["ChannelName"];
+                if (! fs::is_symlink(muxFilePath))
+                {
+                    std::cerr << "Can't find the MUX from " << muxFilePath << std::endl;
+                    return false;
+                }
+                try
+                {
+                    fs::path canonical_p = fs::canonical(muxFilePath);
+                    std::string busDevFN = canonical_p.filename();
+                    size_t pos = busDevFN.find("-");
+                    if (pos == std::string::npos)
+                        return false;
+                    bus = std::stoll(busDevFN.substr(pos + 1));
+                    muxChannelMap[muxChannel["MuxName"]]
+                                 [muxChannel["ChannelName"]] = *bus;
+                    boost::algorithm::replace_all(busPath, "$Bus", std::to_string(*bus));
+                } catch (fs::filesystem_error const& ex) {
+                    std::cout << "Error getting canonical path: " << ex.what() << "\n";
+                    return false;
+                }
            }
         }
         else if (keyPair.key() == "MuxIdleMode")
@@ -439,6 +463,7 @@ bool loadOverlays(const nlohmann::json& systemConfiguration)
         if (unfoundListSize == unfoundList.size())
         {
             std::cerr << "There is an incorrect config" << std::endl;
+            lg2::error("EntityManager might be abnormal due to invalid config.");
             break;
         }
         unfoundListSize = unfoundList.size();
-- 
