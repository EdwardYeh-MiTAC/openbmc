     sdbusplus::asio::object_server& objectServer,
@@ -51,7 +52,7 @@ PSUCombineEvent::PSUCombineEvent(
         "/xyz/openbmc_project/State/Decorator/" + psuNameEscaped + "_" +
             combineEventName,
         "xyz.openbmc_project.State.Decorator.OperationalStatus");
-    eventInterface->register_property("functional", true);
+    eventInterface->register_property(functionalAttr, true);
 
     if (!eventInterface->initialize())
     {
@@ -338,7 +339,7 @@ void PSUSubEvent::updateValue(const int& newValue)
 
             if ((*combineEvent).empty())
             {
-                eventInterface->set_property("functional", true);
+                eventInterface->set_property(functionalAttr, true);
             }
         }
     }
@@ -368,7 +369,7 @@ void PSUSubEvent::updateValue(const int& newValue)
             }
             if ((*combineEvent).empty())
             {
-                eventInterface->set_property("functional", false);
+                eventInterface->set_property(functionalAttr, false);
             }
             (*combineEvent).emplace(groupEventName);
         }
