     auto findDevType = dtmap.find(type->c_str());
     if (findDevType == dtmap.end())
@@ -43,7 +40,17 @@ std::optional<I2CDeviceParams> getI2CDeviceParams(
         return std::nullopt;
     }
 
-    return I2CDeviceParams(findDevType->second, *bus, *addr);
+    addr = static_cast<uint64_t> (*std::get_if<uint64_t>(&findAddr->second));
