+
+int I2CMuxDev::resolveBusNum(const std::string channelName, uint64_t& busNum) {
+    const std::string I2cMuxDevPath = "/dev/i2c-mux/";
+    const std::string symlink_path = I2cMuxDevPath + _muxName + "/" + channelName;
+    if (std::filesystem::is_symlink(symlink_path))
+    {
+        const std::filesystem::path target = std::filesystem::read_symlink(symlink_path);
+        const std::string i2cDevName = target.filename().string();
+        const std::string I2cDevPrefix = "i2c-";
+        size_t anchor = i2cDevName.find(I2cDevPrefix);
+        if (anchor == std::string::npos)
+            return -1;
+
+        const std::string busNumStr = i2cDevName.substr(anchor + I2cDevPrefix.length());
+        try
+        {
+            busNum = std::stoull(busNumStr);
+            return 0;
+        }
+        catch (const std::out_of_range& oor)
+        {
+            lg2::error("Error: Value out of range for uint64_t: '{PATH}'", "PATH", target);
+            return -1;
+        }
+        catch (const std::invalid_argument& ia)
+        {
+            lg2::error("Error: Invalid argument (non-numeric characters): '{PATH}'", "PATH", target);
+            return -1;
+        }
+    }
+    else
+    {
+        lg2::error("Invalid symbolic link '{PATH}'", "PATH", symlink_path);
+        return -1;
+    }
+}
