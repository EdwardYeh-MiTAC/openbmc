From 4a9bf9a1a412dd0b9b9eb445c48cb0a5f3e0d2bd Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Tue, 3 Mar 2026 07:54:23 +0000
Subject: [PATCH 1/1] Skip malformed IPMI Decorators to improve the robustness
 of IPMI Get SDR command.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 dbus-sdr/sdrutils.cpp        | 40 +++++++++++++++-----------
 dbus-sdr/storagecommands.cpp | 54 ++++++++++++++++++++++++------------
 2 files changed, 60 insertions(+), 34 deletions(-)

diff --git a/dbus-sdr/sdrutils.cpp b/dbus-sdr/sdrutils.cpp
index ea39606..5fc0524 100644
--- a/dbus-sdr/sdrutils.cpp
+++ b/dbus-sdr/sdrutils.cpp
@@ -574,26 +574,34 @@ void updateIpmiFromAssociation(
         // just try grabbing the properties first.
         ipmi::PropertyMap::iterator entityIdProp;
         ipmi::PropertyMap::iterator entityInstanceProp;
-        if (ipmiDecoratorPaths.contains(endpoint))
+        try
         {
-            std::map<std::string, Value> ipmiProperties =
-                getEntityManagerProperties(
-                    endpoint.c_str(),
-                    "xyz.openbmc_project.Inventory.Decorator.Ipmi");
-
-            entityIdProp = ipmiProperties.find("EntityId");
-            entityInstanceProp = ipmiProperties.find("EntityInstance");
-            if (entityIdProp != ipmiProperties.end())
-            {
-                entityId = static_cast<uint8_t>(
-                    std::get<uint64_t>(entityIdProp->second));
-            }
-            if (entityInstanceProp != ipmiProperties.end())
+            if (ipmiDecoratorPaths.contains(endpoint))
             {
-                entityInstance = static_cast<uint8_t>(
-                    std::get<uint64_t>(entityInstanceProp->second));
+                std::map<std::string, Value> ipmiProperties =
+                    getEntityManagerProperties(
+                        endpoint.c_str(),
+                        "xyz.openbmc_project.Inventory.Decorator.Ipmi");
+
+                entityIdProp = ipmiProperties.find("EntityId");
+                entityInstanceProp = ipmiProperties.find("EntityInstance");
+                if (entityIdProp != ipmiProperties.end())
+                {
+                    entityId = static_cast<uint8_t>(
+                        std::get<uint64_t>(entityIdProp->second));
+                }
+                if (entityInstanceProp != ipmiProperties.end())
+                {
+                    entityInstance = static_cast<uint8_t>(
+                        std::get<uint64_t>(entityInstanceProp->second));
+                }
             }
         }
+        catch (const std::exception& e)
+        {
+            lg2::warning("Exception while processing entityIdProp. {ERROR}",
+                       "ERROR", e);
+        }
 
         // Now check the entity-manager entry for this sensor to see
         // if it has its own value and use that instead.
diff --git a/dbus-sdr/storagecommands.cpp b/dbus-sdr/storagecommands.cpp
index fb7879e..a985f80 100644
--- a/dbus-sdr/storagecommands.cpp
+++ b/dbus-sdr/storagecommands.cpp
@@ -624,24 +624,33 @@ ipmi::Cc getFruSdrs([[maybe_unused]] ipmi::Context::ptr ctx, size_t index,
         std::optional<uint64_t> maybeBus;
         std::optional<uint64_t> maybeAddress;
         std::optional<std::string> maybeName;
-        for (const auto& [key, val] : i2cProperties)
+        try
         {
-            if (key == "Bus")
-            {
-                maybeBus = std::get<uint64_t>(val);
-            }
-            else if (key == "Address")
+            for (const auto& [key, val] : i2cProperties)
             {
-                maybeAddress = std::get<uint64_t>(val);
+                if (key == "Bus")
+                {
+                    maybeBus = std::get<uint64_t>(val);
+                }
+                else if (key == "Address")
+                {
+                    maybeAddress = std::get<uint64_t>(val);
+                }
+                else if (key == "Name")
+                {
+                    maybeName = std::get<std::string>(val);
+                }
             }
-            else if (key == "Name")
+            if (!maybeBus || *maybeBus != bus || !maybeAddress ||
+                *maybeAddress != address)
             {
-                maybeName = std::get<std::string>(val);
+                continue;
             }
         }
-        if (!maybeBus || *maybeBus != bus || !maybeAddress ||
-            *maybeAddress != address)
+        catch (const std::exception& e)
         {
+            lg2::warning("Exception while processing i2cProperties. {ERROR}",
+                       "ERROR", e);
             continue;
         }
         // At this point we found the device entry and will populate the
@@ -659,17 +668,26 @@ ipmi::Cc getFruSdrs([[maybe_unused]] ipmi::Context::ptr ctx, size_t index,
             "xyz.openbmc_project.Inventory.Decorator.Ipmi", entityData);
         if (!ec)
         {
-            for (const auto& [key, val] : entityData)
+            try
             {
-                if (key == "EntityId")
+                for (const auto& [key, val] : entityData)
                 {
-                    entityID = std::get<uint64_t>(val);
-                }
-                else if (key == "EntityInstance")
-                {
-                    entityInstance = std::get<uint64_t>(val);
+                    if (key == "EntityId")
+                    {
+                        entityID = std::get<uint64_t>(val);
+                    }
+                    else if (key == "EntityInstance")
+                    {
+                        entityInstance = std::get<uint64_t>(val);
+                    }
                 }
             }
+            catch (const std::exception& e)
+            {
+                lg2::warning("Exception while processing entityData. {ERROR}",
+                           "ERROR", e);
+                continue;
+            }
         }
         break;
     }
-- 
