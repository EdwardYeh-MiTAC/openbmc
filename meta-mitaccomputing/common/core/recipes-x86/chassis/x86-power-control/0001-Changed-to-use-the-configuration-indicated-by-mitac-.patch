From 1c0502b1340db0608b18c90a3400cee05776ccf3 Mon Sep 17 00:00:00 2001
From: Jian-Ming Wang <jian.ming.wang@mitaccomputing.com>
Date: Tue, 24 Dec 2024 03:00:17 +0000
Subject: [PATCH 1/1] Changed to use the configuration indicated by
 mitac-sys-init.service.

Upstream-Status: Inappropriate [No upstream maintenance]
---
 .../xyz.openbmc_project.Chassis.Control.Power@.service      | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/service_files/xyz.openbmc_project.Chassis.Control.Power@.service b/service_files/xyz.openbmc_project.Chassis.Control.Power@.service
index 4d676c2..717a8c3 100644
--- a/service_files/xyz.openbmc_project.Chassis.Control.Power@.service
+++ b/service_files/xyz.openbmc_project.Chassis.Control.Power@.service
@@ -1,13 +1,15 @@
 [Unit]
 Description=Intel Power Control for the Host %i
-ConditionPathExists=/usr/share/x86-power-control/power-config-host%i.json
+After=mitac-sys-init.service
+ConditionPathExists=/tmp/mainboard_env.sh
 
 [Service]
 Restart=always
 RestartSec=3
-ExecStart=/usr/bin/power-control %i
+ExecStart=/bin/sh -C /usr/libexec/x86-power-control/power-control.sh %i
 Type=dbus
 BusName=xyz.openbmc_project.State.Host%i
 
 [Install]
 WantedBy=sysinit.target
+
-- 
2.34.1

