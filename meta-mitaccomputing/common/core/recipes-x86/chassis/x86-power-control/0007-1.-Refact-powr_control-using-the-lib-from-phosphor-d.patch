+    osIface->set_property("OperatingSystemState", stageName);
+    appState.set(PersistentState::Params::OperatingSystemOSStatus, stageName);
 
     lg2::info("Moving os state to {STATE} stage", "STATE",
-              getOperatingSystemStateStage(stage));
+              OperatingSystemStatus::convertOSStatusToString(stage));
+}
+
+static std::string propBootProgress;
+
+static int handleBootProgressStageChange(const BootProgressStages progress)
+{
+    // Do not call bootProgressIface->set_property("BootProgress", bootProgressStageName) to avoid recursive
+    std::string bootProgressStageName = BootProgress::convertProgressStagesToString(progress);
+    if (bootProgressStageName != propBootProgress)
+    {
+        // Update BootProgressLastUpdate timestamp.
+        lg2::info("Host{HOST}: BootProgressStage moving to \"{PROGRESS}\" state", "HOST", node, "PROGRESS", bootProgressStageName);
+        std::uint64_t bootProgressLastUpdate = std::chrono::duration_cast<std::chrono::microseconds>(
+                             std::chrono::system_clock::now().time_since_epoch())
+                             .count();
+        bootProgressIface->set_property("BootProgressLastUpdate", bootProgressLastUpdate);
+        appState.set(PersistentState::Params::BootProgressStages, bootProgressStageName);
+        propBootProgress = bootProgressStageName;
+        // Update OperatingSystemState if necessary
+        switch (progress)
+        {
+            case BootProgressStages::Unspecified:
+            case BootProgressStages::PrimaryProcInit:
+            case BootProgressStages::BusInit:
+            case BootProgressStages::MemoryInit:
+            case BootProgressStages::SecondaryProcInit:
+            case BootProgressStages::PCIInit:
+            case BootProgressStages::MotherboardInit:
+                setOperatingSystemState(OperatingSystemOSStatus::Inactive);
+                break;
+            case BootProgressStages::SystemInitComplete:
+            case BootProgressStages::SystemSetup:
+                setOperatingSystemState(OperatingSystemOSStatus::Standby);
+                break;
+            default:
+                lg2::info("Host{HOST}: \"{PROGRESS}\" doesn't impact OperatingSystemOSStatus.", "HOST", node, "PROGRESS", bootProgressStageName);
+                break;
+        }
+    }
+    return 0;
+}
+static int updateBootProgressStage(const BootProgressStages progress)
+{
+    std::string bootProgressStageName = BootProgress::convertProgressStagesToString(progress);
+    if (!bootProgressIface->set_property("BootProgress", bootProgressStageName))
+    {
+        lg2::warning("Host{HOST}: updateBootProgressStage failed.", "HOST", node);
+        return -1;
+    }
+    return 0;
 }
 
