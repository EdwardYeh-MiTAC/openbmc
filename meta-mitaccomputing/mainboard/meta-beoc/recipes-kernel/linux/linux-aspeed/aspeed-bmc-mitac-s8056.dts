/dts-v1/;

#include "aspeed-g6.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>

/ {
	model = "MiTAC S8056 20250516";
	#include "aspeed-bmc-mitac-2600-reserved-memory.dtsi"

        leds {
                compatible = "gpio-leds";

                bmc_heartbeat {
                        gpios = <&gpio0 ASPEED_GPIO(P, 7) GPIO_ACTIVE_LOW>;
                        default-state = "on";
                };
		//Unable to use aspeed-bmc-mitac-common-leds.dtsi due to S8056 has different arrangement for identify led.
                identify {
                        gpios = <&gpio0 ASPEED_GPIO(B, 7) GPIO_ACTIVE_LOW>;
                        default-state = "on";
                };
                cpu_prochot {
                        gpios = <&gpio0 ASPEED_GPIO(C, 5) GPIO_ACTIVE_LOW>;
                        default-state = "off";
                };
        };

        gpio-keys {
                compatible = "gpio-keys";

		#include "aspeed-bmc-mitac-common-buttons.dtsi"
        };

        iio-hwmon {
                compatible = "iio-hwmon";
                io-channels = <&adc0 0>, <&adc0 1>, <&adc0 2>, <&adc0 3>,
                        <&adc0 4>, <&adc0 5>, <&adc0 6>, <&adc0 7>,
                        <&adc1 0>, <&adc1 1>, <&adc1 2>, <&adc1 3>,
                        <&adc1 4>, <&adc1 5>, <&adc1 6>, <&adc1 7>;
        };

        fan0: pwm-fan0 {
                compatible = "pwm-fan";
                pwms = <&pwm_tach 0 40000 0>;   /* Target freq:25 kHz */
                cooling-min-state = <0>;
                cooling-max-state = <3>;
                #cooling-cells = <2>;
                cooling-levels = <0 20 40 64>;
        };

        fan1: pwm-fan1 {
                compatible = "pwm-fan";
                pwms = <&pwm_tach 1 40000 0>;   /* Target freq:25 kHz */
                cooling-min-state = <0>;
                cooling-max-state = <3>;
                #cooling-cells = <2>;
                cooling-levels = <0 32 64 128>;
        };

        fan2: pwm-fan2 {
                compatible = "pwm-fan";
                pwms = <&pwm_tach 2 40000 0>;   /* Target freq:25 kHz */
                cooling-min-state = <0>;
                cooling-max-state = <3>;
                #cooling-cells = <2>;
                cooling-levels = <0 32 64 128>;
        };

        fan3: pwm-fan3 {
                compatible = "pwm-fan";
                pwms = <&pwm_tach 3 40000 0>;   /* Target freq:25 kHz */
                cooling-min-state = <0>;
                cooling-max-state = <3>;
                #cooling-cells = <2>;
                cooling-levels = <0 20 40 64>;
        };

        fan4: pwm-fan4 {
                compatible = "pwm-fan";
                pwms = <&pwm_tach 4 40000 0>;   /* Target freq:25 kHz */
                cooling-min-state = <0>;
                cooling-max-state = <3>;
                #cooling-cells = <2>;
                cooling-levels = <0 32 64 128>;
        };

        fan5: pwm-fan5 {
                compatible = "pwm-fan";
                pwms = <&pwm_tach 5 40000 0>;   /* Target freq:25 kHz */
                cooling-min-state = <0>;
                cooling-max-state = <3>;
                #cooling-cells = <2>;
                cooling-levels = <0 32 64 128>;
        };

        fan7: pwm-fan7 {
                compatible = "pwm-fan";
                pwms = <&pwm_tach 7 40000 0>;   /* Target freq:25 kHz */
                cooling-min-state = <0>;
                cooling-max-state = <3>;
                #cooling-cells = <2>;
                cooling-levels = <0 20 40 64>;
        };
};

&mdio0 {
	status = "okay";

	ethphy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&mac0 {
	status = "okay";

	phy-mode = "rgmii-rxid";
	phy-handle = <&ethphy0>;

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_rgmii1_default>;
};

&mac3 {
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_rmii4_default>;
	clock-names = "MACCLK", "RCLK";
        use-ncsi;
};

&rtc {
	status = "okay";
};

&fmc {
	status = "okay";
	flash@0 {
		status = "okay";
		m25p,fast-read;
		label = "bmc";
		spi-rx-bus-width = <4>;
		spi-max-frequency = <50000000>;
#include "MiOBMC-flash-layout-64.dtsi"
	};
};

&spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi1_default>;

	flash@0 {
		status = "okay";
		m25p,fast-read;
		label = "pnor";
		spi-rx-bus-width = <1>;
		spi-max-frequency = <50000000>;
	};
};

&uart2 {
        status = "okay";
};

&uart3 {
        status = "okay";
};

&uart5 {
	// Workaround for A0
	compatible = "snps,dw-apb-uart";
};

&uart_routing {
        status = "okay";
};

&bmc_dev {
        status = "okay";
        memory-region = <&bmc_dev_memory>;
};

/*
&vuart1{
        status = "okay";
};
*/

&lpc_snoop {
	status = "okay";
	snoop-ports = <0x80>, <0x81>;
};

&lpc_ctrl {
	status = "okay";
};

/*
&lpc_pcc {
        port-addr = <0x80>;
        dma-mode;
	// It is required to be 4 bytes mode when A2600-15 is activated.
        A2600-15;
        memory-region = <&pcc_memory>;
        rec-mode = <0x1>;
        port-addr-hbits-select = <0x1>;
        port-addr-xbits = <0x3>;

        status = "okay";
};
*/

&fsim0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&uhci {
	status = "okay";
};

&sdc {
	status = "okay";
};

&vhub {
	status = "okay";
	pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_usb2ad_default>;
};

&video {
	status = "okay";
	memory-region = <&video_engine_memory>;
};

&kcs1 {
        kcs-io-addr = <0xca0>;
	kcs-channel = <1>;
        status = "okay";
};

&kcs2 {
        kcs-io-addr = <0xca8>;
	kcs-channel = <2>;
        status = "okay";
};

&kcs3 {
        kcs-io-addr = <0xca2>;
	kcs-channel = <3>;
        status = "okay";
};

&jtag0 {
	status = "okay";
};

&jtag1 {
	status = "disabled";
	status = "okay";
};

&wdt1 {
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_wdtrst1_default>;
        aspeed,reset-type = "soc";
        aspeed,external-signal;
        aspeed,ext-push-pull;
        aspeed,ext-active-high;
        aspeed,ext-pulse-duration = <256>;
};

/*
&wdt2 {
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_wdtrst2_default>;
        aspeed,reset-type = "system";
};
*/

&pwm_tach {
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_pwm0_default &pinctrl_pwm1_default
                     &pinctrl_pwm2_default &pinctrl_pwm3_default
                     &pinctrl_pwm4_default &pinctrl_pwm5_default
                     &pinctrl_pwm7_default
                     &pinctrl_tach0_default &pinctrl_tach1_default
                     &pinctrl_tach2_default &pinctrl_tach3_default
                     &pinctrl_tach4_default &pinctrl_tach5_default
                     &pinctrl_tach6_default &pinctrl_tach7_default
                     &pinctrl_tach8_default &pinctrl_tach9_default
                     &pinctrl_tach10_default &pinctrl_tach11_default
                     &pinctrl_tach12_default &pinctrl_tach13_default
                     &pinctrl_tach14_default &pinctrl_tach15_default
                    >;

        fan@0 {
                tach-ch = /bits/ 8 <0x00>;
        };
        fan@1 {
                tach-ch = /bits/ 8 <0x01>;
        };
        fan@2 {
                tach-ch = /bits/ 8 <0x02>;
        };
        fan@3 {
                tach-ch = /bits/ 8 <0x03>;
        };
        fan@4 {
                tach-ch = /bits/ 8 <0x04>;
        };
        fan@5 {
                tach-ch = /bits/ 8 <0x05>;
        };
        fan@6 {
                tach-ch = /bits/ 8 <0x06>;
        };
        fan@7 {
                tach-ch = /bits/ 8 <0x07>;
        };
        fan@8 {
                tach-ch = /bits/ 8 <0x08>;
        };
        fan@9 {
                tach-ch = /bits/ 8 <0x09>;
        };
        fan@10 {
                tach-ch = /bits/ 8 <0x0A>;
        };
        fan@11 {
                tach-ch = /bits/ 8 <0x0B>;
        };
        fan@12 {
                tach-ch = /bits/ 8 <0x0C>;
        };
        fan@13 {
                tach-ch = /bits/ 8 <0x0D>;
        };
        fan@14 {
                tach-ch = /bits/ 8 <0x0E>;
        };
        fan@15 {
                tach-ch = /bits/ 8 <0x0F>;
        };
};

&mbox {
        status = "okay";
};

&i2c0 {
	status = "okay";

	nct7802@28 {
		compatible = "nuvoton,nct7802";
		reg = <0x28>;

		#address-cells = <1>;
		#size-cells = <0>;

		channel@1 {
			reg = <1>;
			sensor-type = "temperature";
			temperature-mode = "thermistor";
		};

		channel@2 {
			reg = <2>;
			sensor-type = "temperature";
			temperature-mode = "thermistor";
		};

		channel@3 {
			reg = <3>;
			sensor-type = "temperature";
			temperature-mode = "thermistor";
		};
	};
};

&i2c1 {
	status = "okay";
	// MB FRU
	eeprom@50 {
		compatible = "atmel,24c256";
		reg = <0x50>;
	};

};
&i2c2 {
    status = "okay";
    bus-frequency = <400000>;

    sbrmi@3c {
	    compatible = "amd,sbrmi";
        reg = <0x3c>;
    };

    sbtsi@4c {
        compatible = "amd,sbtsi";
        reg = <0x4c>;
    };
};
&i2c3 {
	status = "okay";
};
&i2c4 {
	status = "okay";
};
&i2c5 {
	status = "okay";
};
&i2c6 {
	status = "okay";
};
&i2c7 {
	status = "okay";
};
&i2c8 {
	status = "okay";
};
&i2c9 {
	status = "okay";
};

/* M24 MDC3
&i2c10 {
	status = "okay";
};
*/

&i2c11 {
	status = "okay";
};
&i2c12 {
	status = "okay";
};
&i2c13 {
	status = "okay";
};
&i2c14 {
	status = "okay";
};

&i2c15 {
 	status = "okay";
	i2c_slave_backend@30 {
		compatible = "i2c-slave-backend";
		reg = <0x30>;
	};
};


#include <dt-bindings/i3c/i3c.h>
&i3c0 {
        status = "disabled";
        bus-context = /bits/ 8 <I3C_BUS_CONTEXT_JESD403>;
        i2c-scl-hz = <100000>;
        i3c-scl-hz = <2000000>;

        //DIMM A
        spd5118_0_0: spd@50,3C000000000 {
                reg = <0x50 0x3C0 0x00000000>;
                assigned-address = <0x50>;
        };
        pmic5xxx_0_0: pmic@48,20400000000 {
                reg = <0x48 0x204 0x00000000>;
                assigned-address = <0x48>;
        };
        rcd_0_0: rcd@58,2C000000000 {
                reg = <0x58 0x2C0 0x00000000>;
                assigned-address = <0x58>;
        };
        //DIMM B
        spd5118_0_1: spd@51,3C000000001 {
                reg = <0x51 0x3C0 0x00000001>;
                assigned-address = <0x51>;
        };
        pmic5xxx_0_1: pmic@49,20400000001 {
                reg = <0x49 0x204 0x00000001>;
                assigned-address = <0x49>;
        };
        rcd_0_1: rcd@59,2C000000001 {
                reg = <0x59 0x2C0 0x00000001>;
                assigned-address = <0x59>;
        };
        //DIMM C
        spd5118_0_2: spd@52,3C000000002 {
                reg = <0x52 0x3C0 0x00000002>;
                assigned-address = <0x52>;
        };
        pmic5xxx_0_2: pmic@4a,20400000002 {
                reg = <0x4a 0x204 0x00000002>;
                assigned-address = <0x4a>;
        };
        rcd_0_2: rcd@5a,2C000000002 {
                reg = <0x5a 0x2C0 0x00000002>;
                assigned-address = <0x5a>;
        };
        //DIMM D
        spd5118_0_3: spd@53,3C000000003 {
                reg = <0x53 0x3C0 0x00000003>;
                assigned-address = <0x53>;
        };
        pmic5xxx_0_3: pmic@4b,20400000003 {
                reg = <0x4b 0x204 0x00000003>;
                assigned-address = <0x4b>;
        };
        rcd_0_3: rcd@5b,2C000000003 {
                reg = <0x5b 0x2C0 0x00000003>;
                assigned-address = <0x5b>;
        };
};

&i3c1 {
        status = "disabled";
        bus-context = /bits/ 8 <I3C_BUS_CONTEXT_JESD403>;
        i2c-scl-hz = <100000>;
        i3c-scl-hz = <2000000>;

        //DIMM G
        spd5118_1_0: spd@50,3C000000000 {
                reg = <0x50 0x3C0 0x00000000>;
                assigned-address = <0x50>;
        };
        pmic5xxx_1_0: pmic@48,20400000000 {
                reg = <0x48 0x204 0x00000000>;
                assigned-address = <0x48>;
        };
        rcd_1_0: rcd@58,2C000000000 {
                reg = <0x58 0x2C0 0x00000000>;
                assigned-address = <0x58>;
        };
        //DIMM H
        spd5118_1_1: spd@51,3C000000001 {
                reg = <0x51 0x3C0 0x00000001>;
                assigned-address = <0x51>;
        };
        pmic5xxx_1_1: pmic@49,20400000001 {
                reg = <0x49 0x204 0x00000001>;
                assigned-address = <0x49>;
        };
        rcd_1_1: rcd@59,2C000000001 {
                reg = <0x59 0x2C0 0x00000001>;
                assigned-address = <0x59>;
        };
        //DIMM I
        spd5118_1_2: spd@52,3C000000002 {
                reg = <0x52 0x3C0 0x00000002>;
                assigned-address = <0x52>;
        };
        pmic5xxx_1_2: pmic@4a,20400000002 {
                reg = <0x4a 0x204 0x00000002>;
                assigned-address = <0x4a>;
        };
        rcd_1_2: rcd@5a,2C000000002 {
                reg = <0x5a 0x2C0 0x00000002>;
                assigned-address = <0x5a>;
        };
        //DIMM J
        spd5118_1_3: spd@53,3C000000003 {
                reg = <0x53 0x3C0 0x00000003>;
                assigned-address = <0x53>;
        };
        pmic5xxx_1_3: pmic@4b,20400000003 {
                reg = <0x4b 0x204 0x00000003>;
                assigned-address = <0x4b>;
        };
        rcd_1_3: rcd@5b,2C000000003 {
                reg = <0x5b 0x2C0 0x00000003>;
                assigned-address = <0x5b>;
        };
};

&i3c2 {
        status = "disabled";
};

&i3c3 {
        status = "disabled";
};

&i3c4 {
        status = "disabled";
};

&adc0 {
        status = "okay";
        pinctrl-0 = <&pinctrl_adc0_default &pinctrl_adc1_default
                        &pinctrl_adc2_default &pinctrl_adc3_default
                        &pinctrl_adc4_default &pinctrl_adc5_default
                        &pinctrl_adc6_default &pinctrl_adc7_default>;
};

&adc1 {
        status = "okay";
        pinctrl-0 = <&pinctrl_adc8_default &pinctrl_adc9_default
			&pinctrl_adc10_default &pinctrl_adc11_default
			&pinctrl_adc12_default &pinctrl_adc13_default
			&pinctrl_adc14_default &pinctrl_adc15_default>;
};

